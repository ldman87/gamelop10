rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidStudent(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.dob is string && data.dob.size() <= 20 &&
             data.commune is string && data.commune.size() > 0 && data.commune.size() <= 100 &&
             data.parentPhone is string && data.parentPhone.size() >= 8 && data.parentPhone.size() <= 20;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidStudent(request.resource.data);
      allow update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
